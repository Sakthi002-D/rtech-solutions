# ---------------------------------------------------------------------------
# R-Tech Solutions API - environment template
# Copy this file to `server/.env` and fill in real values.
# `server/.env` is git-ignored - NEVER commit real credentials.
# NOTE: use the dedicated R-Tech Supabase PostgreSQL database only.
#       Do NOT reuse or modify the HRMS project's database or credentials.
# ---------------------------------------------------------------------------

# API port (the Vite dev proxy expects 5175 by default)
PORT=5175

# PostgreSQL connection string for the R-Tech Supabase project.
# Find it in: Supabase Dashboard -> Connect -> Connection string -> Session pooler
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres
# Supabase requires TLS on its PostgreSQL connections:
PG_SSL=true

# SMTP notification settings (optional).
# When SMTP_HOST / SMTP_USER / SMTP_PASS are unset, submissions are still
# stored in PostgreSQL - only the notification email is skipped.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="R-Tech Solutions <no-reply@example.com>"
# Where enquiry notifications are delivered:
NOTIFY_EMAIL=notifications@example.com
